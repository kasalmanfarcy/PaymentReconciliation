<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
        <!-- lookup parent from repository -->
    </parent>
    <groupId>com.reconflow</groupId>
    <artifactId>paymentreconflow</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ReconFlow</name>
    <description>Multi-tenant payment reconciliation service: imports internal-ledger and
        payment-gateway settlement files, matches them, and manages the resulting
        exceptions through to an audited resolution.</description>
    <url>https://github.com/kasalmanfarcy/PaymentReconciliation</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kasalmanfarcy</id>
            <url>https://github.com/kasalmanfarcy</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/kasalmanfarcy/PaymentReconciliation.git</connection>
        <developerConnection>scm:git:git@github.com:kasalmanfarcy/PaymentReconciliation.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/kasalmanfarcy/PaymentReconciliation</url>
    </scm>
    <properties>
        <java.version>25</java.version>
        <uuid-creator.version>6.1.1</uuid-creator.version>
        <!-- Spring Modulith 2.1.x is the line built for Spring Boot 4.1. Boot does not manage it. -->
        <spring-modulith.version>2.1.2</spring-modulith.version>
        <spotless-maven-plugin.version>3.11.0</spotless-maven-plugin.version>
        <palantir-java-format.version>2.103.0</palantir-java-format.version>
        <!-- 0.8.14+ is needed to instrument Java 25 class files. -->
        <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
        <!-- M5 ingestion. Boot manages none of these, so they are pinned here. -->
        <commons-csv.version>1.14.1</commons-csv.version>
        <commons-io.version>2.22.0</commons-io.version>
        <awssdk.version>2.59.1</awssdk.version>
        <!-- M6.19 property tests. 1.10.x is the line that runs on the JUnit Platform Boot 4 ships. -->
        <jqwik.version>1.10.2</jqwik.version>
        <!-- M10.5: the weekly vulnerability scan (.github/workflows/dependency-check.yml). -->
        <dependency-check-maven.version>13.0.0</dependency-check-maven.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Keeps every AWS SDK module (s3, apache-client, auth, ...) on one version. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- /actuator/prometheus (M9.10): Micrometer meters in Prometheus' text format, scraped from
             the internal management port. Version managed by Boot. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Secured by default from the start (M2.2): everything but health/info is 401 until
             real authentication arrives in M3.3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- JWT support (M3.3): NimbusJwtEncoder signs our RS256 access tokens and the resource
             server validates them. M10.1 points the same configuration at Keycloak. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Compile scope (not runtime) for one class: shared.error.UniqueViolations reads the
             violated constraint's name from PSQLException's server error message, the only
             reliable way to tell which unique constraint fired (M5.4, M5.9). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- Boot 4 splits autoconfiguration into modules: flyway-core alone gives no
             FlywayAutoConfiguration. The starter brings spring-boot-flyway. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Module annotations (@ApplicationModule, @NamedInterface) and the module model. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <!-- UUIDv7 generator (ADR 0010): the JDK only generates v4 (random) UUIDs. -->
        <dependency>
            <groupId>com.github.f4b6a3</groupId>
            <artifactId>uuid-creator</artifactId>
            <version>${uuid-creator.version}</version>
        </dependency>

        <!-- RFC 4180 CSV parsing (quotes, embedded commas and newlines), streamed record by
             record (M5.10). Never split lines on commas by hand. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>
        <!-- BOMInputStream: strips the UTF-8 byte-order mark Excel writes (M5.10). -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>
        <!-- S3 API client for FileStorage (M5.8): MinIO locally and in tests, S3 in production.
             The synchronous client uses the Apache HTTP client; the Netty client is only for the
             async API, which we don't use, so it is excluded to keep the jar smaller. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ApplicationModules.verify() and Documenter for ModularityTest (M2.9). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Pulled forward from M2.3 so ./mvnw test passes on a fresh clone:
             tests start their own PostgreSQL instead of needing a local one. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Property-based tests (M6.19): a JUnit Platform engine, run by Surefire and Failsafe
             next to Jupiter with no extra configuration. -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Real S3-compatible storage in integration tests (M5.8). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-minio</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Unit tests (*Test) run in the test phase via Surefire: fast, no Docker.
                 Integration tests (*IT) run here, in integration-test, so ./mvnw verify runs
                 everything and a failing IT still lets post-integration-test clean up.
                 Version managed by the Boot parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Coverage report on every build, no threshold yet (M2.14): measure the baseline
                 first, decide in M9 whether to enforce one. prepare-agent sets ${argLine} for
                 Surefire, prepare-agent-integration for Failsafe; if either plugin ever gets its
                 own <argLine>, write it as "@{argLine} ..." or the agent is silently dropped.
                 Reports: target/site/jacoco (unit) and target/site/jacoco-it (integration). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>prepare-agent-it</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                    <execution>
                        <id>report-it</id>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- Formatting is checked, not discussed (M2.13). `./mvnw spotless:apply` formats;
                 `./mvnw verify` fails with a diff if anything is unformatted. Palantir Java Format
                 matches .editorconfig (4-space indent, 120 columns). Only Java and the POM are
                 formatted: SQL migrations are never touched, because changing an applied
                 migration's bytes changes its checksum and Flyway refuses to start. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                    <pom>
                        <sortPom>
                            <expandEmptyElements>false</expandEmptyElements>
                            <!-- .editorconfig: 4-space indent for XML -->
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                        </sortPom>
                    </pom>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- OWASP Dependency-Check (M10.5). Declared here, not bound to a phase: it is slow (it
                 mirrors the NVD) and runs weekly in CI, or on demand with
                 `./mvnw dependency-check:check -DnvdApiKey=...`. Configured here so the local run
                 and CI apply the same threshold and suppressions. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check-maven.version}</version>
                <configuration>
                    <!-- CVSS 7+ (high, critical) fails the scan; the same bar as dependency review. -->
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <!-- Every suppression has a reason and an expiry (see the file). -->
                    <suppressionFiles>
                        <suppressionFile>config/dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <!-- Test-only dependencies never ship in the jar. -->
                    <skipTestScope>true</skipTestScope>
                    <!-- Analyzers that need services or tools we don't use (.NET, Node audit
                         upload, OSS Index account). -->
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
