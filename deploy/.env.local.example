# The local rehearsal of the deployment (compose.local.yaml). Clearly-fake local values only.
RECONFLOW_IMAGE=reconflow
API_PROFILES=prod,api,demo
API_HOST=api.reconflow.localhost
AUTH_HOST=auth.reconflow.localhost
KEYCLOAK_PUBLIC_URL=https://auth.reconflow.localhost:8443
HTTP_PORT=8088
HTTPS_PORT=8443

DB_SUPERUSER_PASSWORD=change-me-rehearsal-superuser
DB_URL=jdbc:postgresql://postgres:5432/paymentreconflow
DB_APP_PASSWORD=change-me-rehearsal-app
DB_MIGRATOR_PASSWORD=change-me-rehearsal-migrator
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KEYCLOAK_DB_PASSWORD=change-me-rehearsal-keycloak

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=reconflow
S3_SECRET_KEY=change-me-rehearsal-minio

KEYCLOAK_ADMIN_PASSWORD=change-me-rehearsal-kc-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-rehearsal-admin-client
RECONFLOW_DEMO_PASSWORD=rehearsal-demo-password
