# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Read by two things:
#   - the application, via spring.config.import: optional:file:.env[.properties]
#   - Docker Compose, which reads .env from the project directory automatically
# A real OS environment variable takes precedence over the file, so CI and
# production supply these the usual way and never ship a .env.

# Database (compose.yaml creates the database and all three roles on first start; README,
# "Database roles").
DB_URL=jdbc:postgresql://localhost:5432/paymentreconflow
# Superuser: compose's POSTGRES_USER, for humans and scripts/*.sh only. Never the application.
DB_USER=reconflow
DB_PASSWORD=change-me
# Flyway: owns the schema (infra/db/bootstrap-roles.sql).
DB_MIGRATOR_USER=reconflow_migrator
DB_MIGRATOR_PASSWORD=change-me-migrator
# The application: data access only, subject to row-level security.
DB_APP_USER=reconflow_app
DB_APP_PASSWORD=change-me-app
DB_POOL_SIZE=10
# Host port compose.yaml publishes PostgreSQL on; change it (and DB_URL) if 5432 is taken.
DB_PORT=5432
PORT=8080

# Object storage (MinIO locally, S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=reconflow
# MinIO requires at least 8 characters.
S3_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET=reconflow-imports
S3_REGION=us-east-1

# Authentication. The local profile generates a JWT key pair at every start, so these stay unset
# locally; prod requires both (PEM). Never put a real key in this file or the repository.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# Password of every user the local seeder creates (default: reconflow-local-demo).
# RECONFLOW_SEED_PASSWORD=
# One-time bootstrap of the first platform admin in a fresh non-local environment.
# RECONFLOW_BOOTSTRAP_ADMIN_EMAIL=

# Observability profile (M9.10): `docker compose --profile observability up -d`.
# Grafana's admin password (http://localhost:3000, user admin). Required only for that profile.
# GRAFANA_ADMIN_PASSWORD=
# Where Prometheus finds the app on the host: leave unset on Docker Desktop; on Colima use 192.168.5.2.
# HOST_GATEWAY=
# Management port (actuator probes and /actuator/prometheus); never exposed publicly.
# MANAGEMENT_PORT=8081
