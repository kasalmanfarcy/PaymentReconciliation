# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Spotless (M2.13, Palantir Java Format) formats Java; keep the editor consistent with it.
[*.java]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.xml]
indent_size = 4

[*.sql]
indent_size = 4

# Markdown uses two trailing spaces as a line break; don't strip them.
[*.{md,plan}]
trim_trailing_whitespace = false

# Windows scripts need CRLF; .gitattributes enforces the same in Git.
[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab

# Sample CSVs are byte-exact fixtures (BOM, CRLF, padded fields).
[docs/samples/*.csv]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
