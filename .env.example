# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Read by two things:
#   - the application, via spring.config.import: optional:file:.env[.properties]
#   - Docker Compose, which reads .env from the project directory automatically
# A real OS environment variable takes precedence over the file, so CI and
# production supply these the usual way and never ship a .env.

# Database (compose.yaml creates this user and database on first start)
DB_URL=jdbc:postgresql://localhost:5432/paymentreconflow
DB_USER=reconflow
DB_PASSWORD=change-me
DB_POOL_SIZE=10
# Host port compose.yaml publishes PostgreSQL on; change it (and DB_URL) if 5432 is taken.
DB_PORT=5432
PORT=8080

# Object storage (MinIO locally, S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=reconflow
# MinIO requires at least 8 characters.
S3_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET=reconflow-imports
S3_REGION=us-east-1
