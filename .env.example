# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Loaded automatically by application.yml via:
#   spring.config.import: optional:file:.env[.properties]
# A real OS environment variable takes precedence over the file, so CI and
# production supply these the usual way and never ship a .env.
DB_URL=jdbc:postgresql://localhost:5432/paymentreconflow
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_POOL_SIZE=10
PORT=8080
