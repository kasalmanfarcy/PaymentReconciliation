# Deployment settings for compose.prod.yaml (M11.4). Copy to deploy/.env on the VM, fill in, and
# keep it readable by the deploy user only (chmod 600). Never commit it (.gitignore).
# docs/runbooks/deploy.md explains each value.

# --- What to run -------------------------------------------------------------------------------
RECONFLOW_IMAGE=ghcr.io/kasalmanfarcy/reconflow
# RECONFLOW_TAG is passed by deploy.sh (sha-<commit>); don't set it here.
# prod,api for a real deployment; prod,api,demo for the public demo (seeds the demo organizations
# and refuses if the database holds any other organization).
API_PROFILES=prod,api

# --- Public names (DNS records pointing at this VM) -------------------------------------------
API_HOST=api.example.com
AUTH_HOST=auth.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com
# Let's Encrypt account contact (expiry notices).
ACME_EMAIL=

# --- Managed PostgreSQL 16 (run infra/db/bootstrap-roles.sql and bootstrap-keycloak.sql once) ---
DB_URL=jdbc:postgresql://db.example.com:5432/paymentreconflow?sslmode=verify-full
DB_APP_USER=reconflow_app
DB_APP_PASSWORD=
# Only the migrate step receives this one.
DB_MIGRATOR_USER=reconflow_migrator
DB_MIGRATOR_PASSWORD=
KC_DB_URL=jdbc:postgresql://db.example.com:5432/keycloak?sslmode=verify-full
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# --- S3-compatible bucket (public access blocked; a key scoped to this bucket) -----------------
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=reconflow-imports
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Keycloak -----------------------------------------------------------------------------------
# Temporary bootstrap admin of the master realm: replace with a named admin after the first start.
KEYCLOAK_ADMIN_PASSWORD=
# The reconflow-admin service account (user management). Generate: openssl rand -base64 32
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Password of the realm's demo accounts (12-64 characters). Required by the realm import.
RECONFLOW_DEMO_PASSWORD=
# Origin of a future browser UI (the reconflow-web client); leave as is until one exists.
RECONFLOW_WEB_ORIGIN=https://app.example.invalid
# One-time: the first platform admin's email (verified in Keycloak). Remove after the first login.
RECONFLOW_BOOTSTRAP_ADMIN_EMAIL=
