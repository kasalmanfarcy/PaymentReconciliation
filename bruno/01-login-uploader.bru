meta {
  name: 01 Log in as the uploader (local realm only)
  type: http
  seq: 1
}

post {
  url: {{keycloakUrl}}/realms/reconflow/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: reconflow-demo
  username: {{uploaderUser}}
  password: {{demoPassword}}
}

script:post-response {
  bru.setVar("uploaderToken", res.body.access_token);
}

tests {
  test("token issued", () => {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
  });
}
