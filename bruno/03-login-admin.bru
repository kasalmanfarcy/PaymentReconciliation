meta {
  name: 03 Log in as the org admin
  type: http
  seq: 3
}

post {
  url: {{keycloakUrl}}/realms/reconflow/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: reconflow-demo
  username: {{adminUser}}
  password: {{demoPassword}}
}

script:post-response {
  bru.setVar("adminToken", res.body.access_token);
}

tests {
  test("token issued", () => {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
  });
}
