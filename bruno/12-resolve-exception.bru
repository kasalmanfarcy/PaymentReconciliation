meta {
  name: 12 Resolve it with If-Match
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/exceptions/{{exceptionId}}/resolve
  body: json
  auth: bearer
}

auth:bearer {
  token: {{investigatorToken}}
}

headers {
  If-Match: {{etag}}
}

body:json {
  {
    "resolutionCode": "GATEWAY_FEE",
    "note": "Gateway deducted its fee before settlement; confirmed on the statement."
  }
}

tests {
  test("resolved", () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("RESOLVED");
  });
}
