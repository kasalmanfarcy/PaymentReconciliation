meta {
  name: 10 The run's open exceptions (the work queue)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/exceptions?runId={{runId}}&status=OPEN&size=50
  auth: bearer
}

auth:bearer {
  token: {{investigatorToken}}
}

script:post-response {
  const c = res.body.content.find((e) => e.reference === "DEMO-302");
  bru.setVar("exceptionId", c ? c.id : "");
}

tests {
  test("eight open cases, DEMO-302 among them", () => {
    expect(res.status).to.equal(200);
    expect(res.body.content).to.have.lengthOf(8);
    expect(bru.getVar("exceptionId")).to.not.equal("");
  });
}
